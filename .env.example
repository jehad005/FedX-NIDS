# ==============================================================================
# SecureFed-NIDS Environment Configuration
# ==============================================================================

# Central HQ API & Client Node Ports
HQ_URL=http://localhost:8000
CLIENT_ID=client_node_01
EDGE_PORT=5000

# Edge Operator Master Security Key (HMAC-SHA256 Token)
ADMIN_KEY=securefed-admin-token-2026

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
# Get them from: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:5000/api/client/auth/callback/google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# GitHub OAuth App Credentials
# Get them from: https://github.com/settings/developers
# Authorization Callback URL: http://localhost:5000/api/client/auth/callback/github
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
